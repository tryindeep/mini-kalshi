      "boundElements": null,
      "updated": 1761822000051,
      "link": null,
      "locked": false,
      "text": "LEGEND:  PK = primary key     FK = foreign key     1:M = one-to-many     1:2 = exactly two outcome rows",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LEGEND:  PK = primary key     FK = foreign key     1:M = one-to-many     1:2 = exactly two outcome rows",
      "autoResize": false,
      "lineHeight": 1.25
    },
